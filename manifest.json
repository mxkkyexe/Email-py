{
  "manifest_version": 3,
  "name": "Email-py",
  "version": "1.1.1",
  "description": "Copy Gmail recipient addresses, or add them to your latest edited draft.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
